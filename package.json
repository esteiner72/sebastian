{
  "name": "sebastian-cc",
  "version": "0.1.0-rc.2",
  "description": "A Claude Code plugin that makes compaction recoverable",
  "license": "MIT",
  "author": {
    "name": "Ethan Steiner",
    "email": "ethansteiner14@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esteiner72/sebastian.git"
  },
  "homepage": "https://github.com/esteiner72/sebastian#readme",
  "type": "module",
  "bin": {
    "seb": "dist/index.js"
  },
  "files": [
    "dist",
    "hooks",
    "skills",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16.0 <23 || >=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "claude-code",
    "plugin",
    "compaction",
    "context",
    "memory"
  ],
  "scripts": {
    "setup": "./scripts/setup.sh",
    "build": "tsc -p tsconfig.build.json && cp src/store/schema.sql dist/store/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "eval:build": "tsc -p eval/tsconfig.json && cp src/store/schema.sql .eval-build/src/store/",
    "eval": "npm run eval:build && node .eval-build/eval/harness.js",
    "eval:baseline": "npm run eval:build && node .eval-build/eval/harness.js --write-baseline",
    "eval:full": "npm run eval:build && node .eval-build/eval/harness.js --full",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:shapes": "node scripts/check-fixture-shapes.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
